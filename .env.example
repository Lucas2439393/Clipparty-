# Kopieer dit bestand naar ".env" en vul je eigen keys in.

# Verplicht: Groq API key. Gebruikt voor Whisper-transcriptie EN als
# standaard LLM-provider voor briefing-extractie, clipselectie, compliance
# en captions. Geen betaalde Anthropic API nodig -- dit is de enige key die
# je echt moet invullen om Clip Studio te laten werken.
GROQ_API_KEY=gsk_...

# Optioneel: Anthropic (Claude) API key. Alleen nodig als je in de
# instellingen expliciet voor provider "anthropic" kiest in plaats van de
# standaard "groq". Laat deze leeg als je geen Anthropic wilt gebruiken --
# de app crasht daar nooit op en schakelt dan automatisch terug naar Groq.
ANTHROPIC_API_KEY=

# Optioneel: standaard LLM-provider voor tekst-taken. "groq" of "anthropic".
# Kan ook per campagne overschreven worden via settings.llm_provider in de
# UI/API. Als hier "anthropic" staat maar ANTHROPIC_API_KEY leeg is, valt de
# app automatisch terug op "groq".
LLM_PROVIDER=groq

# Optioneel: pad naar ffmpeg/ffprobe als deze niet in PATH staan
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optioneel: output map (standaard C:\Users\<jij>\ClipperOutput)
CLIPPER_OUTPUT_DIR=C:\Users\lucas\ClipperOutput

# Optioneel: poort voor de lokale API (voor de toekomstige Lovable GUI)
API_PORT=8756

# Optioneel: Groq-model voor tekst-taken (briefing/clipselectie/compliance/
# captions). LAAT DIT LEEG voor automatische modelselectie -- de app vraagt
# dan zelf op welke modellen jouw GROQ_API_KEY mag gebruiken via
# GET https://api.groq.com/openai/v1/models en kiest automatisch het beste
# beschikbare model (voorkeursvolgorde: openai/gpt-oss-120b,
# openai/gpt-oss-20b, qwen/qwen3-32b, groq/compound-mini, groq/compound).
# Vul dit alleen in om een specifiek model te forceren -- als dat model niet
# beschikbaar blijkt voor jouw key, valt de app automatisch terug op de
# voorkeursvolgorde hierboven.
GROQ_LLM_MODEL=

# Optioneel: Groq whisper model (transcriptie)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optioneel: Claude-model, alleen gebruikt als LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-sonnet-4-6
